# Local-only sign-in helper: holds a live access token. Never commit.
feed/dev-signin.html

# Scan run artifacts: raw scraped posts and the TA index cache. Regenerated
# per run and large. judgments.json is kept: it records how borderline posts
# were judged, so a later run can stay consistent with an earlier one.
.github/scan/scraped-posts*.json
.github/scan/ta-index-*.json
.github/scan/seen-threads.json
.github/scan/dump.mjs

# Local scan credentials.
.github/scan/.env
