# PostHog reverse proxy (assets/js/analytics.js sends to /ingest) so ad
# blockers don't drop events. static/ and array/ must come before the
# catch-all. EU project: swap us -> eu in all three.
/ingest/static/*  https://us-assets.i.posthog.com/static/:splat  200!
/ingest/array/*   https://us-assets.i.posthog.com/array/:splat   200!
/ingest/*         https://us.i.posthog.com/:splat                200!

# Pages permanently removed. These must be 301, not 302 — a 302 tells
# Google the URL still exists and keeps the old page (and its pricing)
# in the index.
/pricing.html            /  301
/webinar.html            /  301
/resources/webinar.html  /  301

# Per-platform pages retired; the landing page now covers platform scope
/platforms/*  /  301

# The AI Safari Sales Rep page is now the whole site; every other page goes home.
# The ! forces the redirect even though the old files are still in the repo.
/sales-rep             /  301!
/sales-rep.html        /  301!
/platform              /  301!
/platform.html         /  301!
/blog                  /  301!
/blog/*                /  301!
